# The Discord application's OAuth2 credentials (Developer Portal -> OAuth2).
# User unit: ~/.config/sm64-relay/env    System unit: /etc/sm64-relay/env    Keep it chmod 600.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Signs the short-lived sessions that unlock the game files (everything but index.html, boot.js,
# vendor/ and favicon.ico) after a player's Discord membership is checked. A session is shared by
# everyone loading in the same window (up to 90 minutes): it keeps casual downloaders out, it is not
# per-user access control. At least 32 characters; make one with
#   openssl rand -hex 32
# If unset, the relay picks a random one at each start (players loading the game during a restart
# then have to reopen the Activity). Keep it as private as the client secret.
SM64_ASSET_SECRET=

# Optional: enable operator-hosted read-only ROM delivery to Discord Activity clients.
# Use an absolute path outside the relay's --www tree; the relay user must be able to read it.
# On startup the relay validates and loads a nonempty regular file of at most 32 MiB into memory.
# Clients receive the ROM bytes after Discord membership/allowlist checks; this is not DRM or a license.
# SM64_ROM_PATH=/srv/sm64-private/baserom.us.z64
# DISCORD_GUILD_IDS=123456789012345678,234567890123456789
